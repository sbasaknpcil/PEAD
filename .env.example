# Get these from https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Group/topic the PEAD cards come from (defaults match the "Financially Free
# Premium Community" -> "PEAD" topic; override if yours differ). GROUP_ID is
# the raw channel id as it appears in web.telegram.org/k/#-<id> or t.me/c/<id>/...
TELEGRAM_GROUP_ID=2413883243
TELEGRAM_PEAD_TOPIC_ID=683
TELEGRAM_SIGNAL_SENDER=FinanciallyFreeFFBot

# Paper trading portfolio
STARTING_CAPITAL_INR=1000000
MAX_POSITION_VALUE_INR=100000
MAX_OPEN_POSITIONS=10

# Trading rule thresholds
PEAD_BUY_SCORE_MIN=50
STOP_LOSS_PCT=0.08
TARGET_PCT=0.15
REQUIRE_ABOVE_200DMA=true

# How often (seconds) to poll open positions for stop-loss/target exits
POSITION_CHECK_INTERVAL_SECONDS=300
