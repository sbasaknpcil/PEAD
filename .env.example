# Get these from https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Group/topic the PEAD cards come from (defaults match the "Financially Free
# Premium Community" -> "PEAD" topic; override if yours differ). GROUP_ID is
# the raw channel id as it appears in web.telegram.org/k/#-<id> or t.me/c/<id>/...
TELEGRAM_GROUP_ID=2413883243
TELEGRAM_PEAD_TOPIC_ID=683
TELEGRAM_SIGNAL_SENDER=FinanciallyFreeFFBot

# Second channel used to confirm PEAD signals (must be one you're a member
# of) - a stock only buys once both channels flag it the same (IST) day.
CONFIRMATION_CHANNEL=earnings_pulse
CONFIRMATION_RATING_LABEL=Excellent

# Paper trading portfolio
STARTING_CAPITAL_INR=1000000
MAX_POSITION_VALUE_INR=100000
MAX_OPEN_POSITIONS=10

# Trading rule thresholds
PEAD_BUY_SCORE_MIN=50
REQUIRE_ABOVE_200DMA=true
MIN_MARKET_CAP_CR=2000
RSI_PERIOD=14
RSI_MIN=50

# Exit strategy - intraday only, position always closes same day as entry:
# sell on a same-day gain of SAME_DAY_TARGET_PCT, else a stop trailing
# TRAILING_STOP_PCT below the highest price since entry, else force-close
# near market close (MARKET_CLOSE_IST_HOUR:MARKET_CLOSE_IST_MINUTE).
SAME_DAY_TARGET_PCT=0.05
TRAILING_STOP_PCT=0.02

# Buys are only taken inside this window - a signal confirmed outside NSE
# trading hours would just buy and immediately force-close near the same
# price under the same-day-only rule, so it's skipped entirely instead.
MARKET_OPEN_IST_HOUR=9
MARKET_OPEN_IST_MINUTE=15
MARKET_CLOSE_IST_HOUR=15
MARKET_CLOSE_IST_MINUTE=25

# How often (seconds) to poll open positions for exits
POSITION_CHECK_INTERVAL_SECONDS=300
