# Get these from https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Group/topic the PEAD cards come from (defaults match the "Financially Free
# Premium Community" -> "PEAD" topic; override if yours differ). GROUP_ID is
# the raw channel id as it appears in web.telegram.org/k/#-<id> or t.me/c/<id>/...
TELEGRAM_GROUP_ID=2413883243
TELEGRAM_PEAD_TOPIC_ID=683
TELEGRAM_SIGNAL_SENDER=FinanciallyFreeFFBot

# Confirmation channel (must be one you're a member of) - every stock this channel
# rates BUY_RATING_LABEL is bought immediately, during market hours. No PEAD score,
# 200DMA, RSI, or market-cap check.
CONFIRMATION_CHANNEL=earnings_pulse
BUY_RATING_LABEL=Excellent

# Paper trading portfolio
STARTING_CAPITAL_INR=1000000
MAX_POSITION_VALUE_INR=100000
MAX_OPEN_POSITIONS=10

# PEAD cards from the topic below are still downloaded and logged for reference,
# and these thresholds still drive list_signals.py/backtest.py's PEAD-card analysis,
# but none of it gates a live buy anymore.
PEAD_BUY_SCORE_MIN=50
REQUIRE_ABOVE_200DMA=true
MIN_MARKET_CAP_CR=2000
RSI_PERIOD=14
RSI_MIN=50

# Exit strategy - intraday only, position always closes same day as entry, no upper
# target: ride it until a stop trailing TRAILING_STOP_PCT below the highest price
# since entry, or a forced close near market close, whichever comes first.
TRAILING_STOP_PCT=0.02

# Buys only happen inside this window - a rating outside NSE trading hours has no
# same-day trading window left under the intraday-only rule, so it's skipped.
MARKET_OPEN_IST_HOUR=9
MARKET_OPEN_IST_MINUTE=15
MARKET_CLOSE_IST_HOUR=15
MARKET_CLOSE_IST_MINUTE=0

# How often (seconds) to poll open positions for exits
POSITION_CHECK_INTERVAL_SECONDS=300

# Backtest: 5m intraday bars only go back ~60 days, and the strategy itself is
# inherently intraday-precise, so this defaults much shorter than a daily backtest.
INTRADAY_BACKTEST_LOOKBACK_DAYS=7
